{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://college-bus.local/schemas/entities.schema.json",
  "title": "CollegeBusCoreEntities",
  "description": "Draft entity inventory. Canonical: docs/architecture/DATA_MODEL.md. No ML entities.",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "colleges",
          "college_domains",
          "users",
          "college_memberships",
          "otp_challenges",
          "college_applications",
          "campuses",
          "campus_settings",
          "buses",
          "routes",
          "stops",
          "route_stops",
          "students",
          "student_import_batches",
          "student_import_rows",
          "planning_runs",
          "planning_run_items",
          "allocations",
          "trips",
          "trip_qr_tokens",
          "boarding_records",
          "trip_location_pings",
          "distress_events",
          "emergency_reallocations",
          "audit_logs"
        ]
      }
    },
    "identifier_strategy": { "const": "uuid" },
    "tenancy": { "const": "college_id on tenant-owned tables" }
  },
  "required": ["entities", "identifier_strategy", "tenancy"]
}
