# Prefer pg8000 on Windows when App Control blocks psycopg DLLs.
# Match POSTGRES_* from repo-root `.env` used by docker compose.
DATABASE_URL=postgresql+pg8000://postgres:replace_me_local_only@localhost:5432/college_bus
SECRET_KEY=replace-with-long-random-string
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
SESSION_COOKIE_NAME=cbc_session
SESSION_TTL_SECONDS=604800
BOOTSTRAP_OPERATOR_EMAIL=operator@example.com
DNS_VERIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

