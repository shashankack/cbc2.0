# Copy to `.env` at repo root (gitignored) for docker compose + local tools.
# Do not commit real production credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me_local_only
POSTGRES_DB=college_bus

# Backend (prefer backend/.env)
DATABASE_URL=postgresql+pg8000://postgres:replace_me_local_only@localhost:5432/college_bus

SECRET_KEY=replace-with-long-random-string
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
# DNS TXT checks: omit to auto-enable when APP_ENV=production; set false to skip.
# DNS_VERIFY_ENABLED=false
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Frontend → frontend/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
