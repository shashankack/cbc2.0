# Backend
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/college_bus
SECRET_KEY=replace-with-long-random-string
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
CORS_ORIGINS=http://localhost:3000
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=2

# Frontend (also copy into frontend/.env.local for Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ML service
ML_DATA_SOURCE=synthetic_demo
MODEL_VERSION=baseline-v1
